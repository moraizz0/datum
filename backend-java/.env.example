# Copie para .env (na pasta backend) e preencha. NUNCA envie o .env ao GitHub.

# Banco PostgreSQL (Neon): use a URL no formato JDBC
DB_URL=jdbc:postgresql://SEU-HOST.neon.tech/SEU_BANCO?sslmode=require
DB_USER=
DB_PASSWORD=

# Segredo do token JWT: mínimo 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# Endereço do front-end (pode listar vários, separados por vírgula)
CORS_ORIGINS=http://localhost:5173

# Primeiro administrador (criado na primeira vez que o servidor liga)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@datum.local
ADMIN_PASSWORD=

# Upload e ponte com o Python (ETL)
UPLOAD_MAX_LINHAS=5000
ETL_ENABLED=false
ETL_URL=http://localhost:8000/etl
ETL_KEY=
